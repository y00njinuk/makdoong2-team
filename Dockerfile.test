# Ubuntu test image for makdoong2-team.
#
# The plugin is developed and run on Ubuntu, but the test suite is regularly
# executed on macOS too. Several suites are sensitive to the difference (libc
# ctype tables, /var symlinks, bash 3.2 vs 5.x), so this image pins the Linux
# side of that matrix and lets `npm run test:ubuntu` reproduce it from any host.
#
# 베이스는 **사용자가 실제로 쓰는 환경**에 맞춘다 (GitHub 이슈 #5/#6 의 환경표):
#   Ubuntu 26.04 LTS (WSL2) · node v24.x · tmux 3.6a · bash 5.3
# 24.04 로 검증하면 tmux 3.4 / bash 5.2 를 보게 되는데, 배포 대상은 3.6a / 5.3 이라
# 정작 사용자가 겪는 축이 검증되지 않는다.
#
# 26.04 의 distro nodejs 는 22.x 라 사용자의 24.x 와 다르므로 NodeSource 를 쓴다.
FROM ubuntu:26.04

ARG NODE_MAJOR=24

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg git jq tmux bash procps locales \
 && sed -i 's/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen \
 && locale-gen \
 && curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# A UTF-8 locale is what developers actually run under; the C locale would mask
# multibyte-adjacent shell bugs instead of exposing them.
ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

WORKDIR /w
